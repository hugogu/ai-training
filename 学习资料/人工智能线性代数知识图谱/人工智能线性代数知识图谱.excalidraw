      "seed": 2336105,
      "version": 2,
      "versionNonce": 30385,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792281600000,
      "link": null,
      "locked": false,
      "fontSize": 24,
      "fontFamily": 2,
      "text": "随时穿插 09 数值实践，用 10 的小例子自检。能说明“对象是什么、形状为何匹配、几何上改变了什么”，再进入下一层。",
      "originalText": "随时穿插 09 数值实践，用 10 的小例子自检。能说明“对象是什么、形状为何匹配、几何上改变了什么”，再进入下一层。",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.4
    },
