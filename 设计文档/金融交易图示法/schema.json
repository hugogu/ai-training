{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FTN 1.1 Business Analysis",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.1"
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "currency_scale": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 8
      }
    },
    "parties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/party"
      },
      "minItems": 1
    },
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/account"
      },
      "minItems": 1
    },
    "orders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/order"
      },
      "minItems": 1
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/money"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 1
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      },
      "minItems": 0
    },
    "information": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/information"
      },
      "minItems": 0
    },
    "journals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/journal"
      },
      "minItems": 0
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 0
    },
    "refund": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/refund"
        }
      ]
    }
  },
  "required": [
    "version",
    "scenario",
    "currency_scale",
    "parties",
    "accounts",
    "orders",
    "components",
    "events",
    "flows",
    "information",
    "journals",
    "records",
    "refund"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "money": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "currency",
        "minor"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "$ref": "#/$defs/id"
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "title",
        "entity",
        "currency",
        "scope",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "party": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "account": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "nature": {
          "enum": [
            "asset",
            "liability",
            "revenue",
            "expense",
            "external"
          ]
        },
        "kind": {
          "enum": [
            "ledger",
            "bank",
            "external"
          ]
        },
        "party": {
          "$ref": "#/$defs/id"
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "bank": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "code",
        "nature",
        "kind",
        "party",
        "currency",
        "bank"
      ],
      "additionalProperties": false
    },
    "order": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "payment",
            "refund"
          ]
        },
        "original_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type",
        "original_ref"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "order_ref": {
          "$ref": "#/$defs/id"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "order_ref",
        "condition",
        "after"
      ],
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "F",
            "L"
          ]
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "money": {
          "$ref": "#/$defs/money"
        },
        "event_ref": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "kind",
        "from",
        "to",
        "money",
        "event_ref"
      ],
      "additionalProperties": false
    },
    "information": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from_party": {
          "$ref": "#/$defs/id"
        },
        "to_party": {
          "$ref": "#/$defs/id"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "event_ref": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "from_party",
        "to_party",
        "meaning",
        "event_ref"
      ],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "account_ref": {
          "$ref": "#/$defs/id"
        },
        "side": {
          "enum": [
            "DR",
            "CR"
          ]
        },
        "money": {
          "$ref": "#/$defs/money"
        }
      },
      "required": [
        "account_ref",
        "side",
        "money"
      ],
      "additionalProperties": false
    },
    "journal": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "event_ref": {
          "$ref": "#/$defs/id"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          },
          "minItems": 2
        }
      },
      "required": [
        "id",
        "event_ref",
        "rows"
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "order_ref": {
          "$ref": "#/$defs/id"
        },
        "perspective": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "money": {
          "$ref": "#/$defs/money"
        },
        "event_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "order_ref",
        "perspective",
        "meaning",
        "money",
        "event_refs"
      ],
      "additionalProperties": false
    },
    "cap": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "original_money": {
          "$ref": "#/$defs/money"
        },
        "prior_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "flow_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "component",
        "original_money",
        "prior_minor",
        "flow_refs"
      ],
      "additionalProperties": false
    },
    "refund": {
      "type": "object",
      "properties": {
        "original_scenario_ref": {
          "$ref": "#/$defs/id"
        },
        "original_order_ref": {
          "$ref": "#/$defs/id"
        },
        "order_ref": {
          "$ref": "#/$defs/id"
        },
        "caps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cap"
          },
          "minItems": 1
        }
      },
      "required": [
        "original_scenario_ref",
        "original_order_ref",
        "order_ref",
        "caps"
      ],
      "additionalProperties": false
    }
  }
}
